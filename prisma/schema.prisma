generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int                 @id @default(autoincrement())
  name             String
  email            String              @unique
  passwordHash     String
  contactNo        String?
  birthDate        DateTime?
  nationality      String?
  gender           Gender?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  sessions         Session[]
  roles            UserRole[]
  projectsCreated  Project[]           @relation("ProjectsCreated")
  projectsAssigned Project[]           @relation("ProjectsAssigned")
  tasksAssigned    Task[]              @relation("TasksAssigned")
  tags             Tag[]               @relation("UserTags")
  notes            Note[]
  schedules        Schedule[]
  plans            Plan[]
  walletAccounts   WalletAccount[]
  transactions     WalletTransaction[]
  notifications    Notification[]
  streak           Streak?
  taskInstances    TaskInstance[]
  comments         TaskComment[]
  histories        TaskHistory[]
}

model Session {
  token     String   @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now())
  userRoles UserRole[]
}

model UserRole {
  id     Int  @id @default(autoincrement())
  userId Int
  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Project {
  id           Int        @id @default(autoincrement())
  name         String
  description  String?
  createdById  Int
  assignedToId Int?
  createdAt    DateTime   @default(now())
  createdBy    User       @relation("ProjectsCreated", fields: [createdById], references: [id])
  assignedTo   User?      @relation("ProjectsAssigned", fields: [assignedToId], references: [id])
  taskLists    TaskList[]
}

model TaskList {
  id        Int      @id @default(autoincrement())
  name      String
  projectId Int
  createdAt DateTime @default(now())
  tasks     Task[]
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Task {
  title        String
  description  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  assignedToId Int?
  dueDate      DateTime?
  listId       Int?
  priority     Priority       @default(MEDIUM)
  status       TaskStatus     @default(PENDING)
  id           Int            @id @default(autoincrement())
  scheduleId   Int?
  pinned       Boolean        @default(false)
  assignedTo   User?          @relation("TasksAssigned", fields: [assignedToId], references: [id])
  list         TaskList?      @relation(fields: [listId], references: [id], onDelete: Cascade)
  schedule     Schedule?      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  submissionUrl String?
  comments     TaskComment[]
  histories    TaskHistory[]
  instances    TaskInstance[]
}

model TaskComment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  comment   String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TaskHistory {
  id         Int      @id @default(autoincrement())
  taskId     Int
  userId     Int
  changeType String
  changeTime DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Schedule {
  name      String
  timezone  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]
}

model TaskInstance {
  scheduledFor     DateTime
  completed        Boolean   @default(false)
  completedAt      DateTime?
  notificationSent Boolean   @default(false)
  createdAt        DateTime  @default(now())
  id               Int       @id @default(autoincrement())
  taskId           Int
  userId           Int
  task             Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledFor])
}

model Note {
  id          Int              @id @default(autoincrement())
  title       String
  content     String
  pinned      Boolean          @default(false)
  important   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  userId      Int
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments NoteAttachment[]
  tags        NoteTag[]
}

model NoteAttachment {
  noteId    Int
  type      AttachmentType
  url       String
  filename  String?
  meta      Json?
  createdAt DateTime       @default(now())
  id        Int            @id @default(autoincrement())
  note      Note           @relation(fields: [noteId], references: [id], onDelete: Cascade)
}

model Tag {
  name      String
  createdAt DateTime  @default(now())
  id        Int       @id @default(autoincrement())
  userId    Int
  notes     NoteTag[]
  user      User      @relation("UserTags", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model NoteTag {
  noteId Int
  id     Int  @id @default(autoincrement())
  tagId  Int
  note   Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([noteId, tagId])
}

model Plan {
  title        String
  description  String?
  dueDate      DateTime?
  pinned       Boolean    @default(false)
  important    Boolean    @default(false)
  status       PlanStatus @default(PENDING)
  reminderSent Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  id           Int        @id @default(autoincrement())
  userId       Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WalletAccount {
  name         String              @default("Main Wallet")
  currency     String              @default("INR")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  id           Int                 @id @default(autoincrement())
  userId       Int
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  amount       Decimal         @db.Decimal(12, 2)
  type         TransactionType
  category     String?
  note         String?
  counterparty String?
  occurredAt   DateTime        @default(now())
  createdAt    DateTime        @default(now())
  id           Int             @id @default(autoincrement())
  accountId    Int
  userId       Int
  account      WalletAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
}

model Notification {
  channel      NotificationChannel
  payload      Json
  scheduledFor DateTime?
  sentAt       DateTime?
  delivered    Boolean             @default(false)
  createdAt    DateTime            @default(now())
  id           Int                 @id @default(autoincrement())
  userId       Int
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Streak {
  currentStreak     Int       @default(0)
  bestStreak        Int       @default(0)
  lastSuccessDate   DateTime?
  consecutiveMisses Int       @default(0)
  updatedAt         DateTime  @updatedAt
  id                Int       @id @default(autoincrement())
  userId            Int       @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttachmentType {
  IMAGE
  LINK
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum PlanStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  UPLOADED
  RE_SUBMISSION
}
